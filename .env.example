# Copy to .env.local. Generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Durable local database; use a persistent writable volume outside local development.
DATABASE_PATH=.data/library.sqlite

# Exact owner address. No first-user auto-promotion. Provision it with create-owner.ts.
OWNER_EMAIL=

# Optional. Both values are required to enable Google sign-in.
# OAuth callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
